# Skopiuj do docker-deploy/.env i uzupełnij przed pierwszym uruchomieniem.
# Generuj APP_KEY: docker compose run --rm app php artisan key:generate --show

APP_NAME="Krakowskie Forum Organizacji Społecznych"
APP_KEY=

# Podmień na docelową domenę tej instancji.
APP_URL=http://localhost:3402
HTTP_PORT=3402

# Seeder uruchamiany przy starcie kontenera (dane demo szablonu "federation").
# Wyczyść tę zmienną, jeśli chcesz wdrożyć czysty CMS bez danych startowych.
SEED_CLASS=Database\Seeders\FederationDemoSeeder

# Poczta — domyślnie logi (log), zmień na smtp w produkcji
MAIL_MAILER=log
MAIL_FROM_ADDRESS=biuro@krafos.pl
MAIL_FROM_NAME="Krakowskie Forum Organizacji Społecznych"

# Opcjonalnie (smtp):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
