# Skopiuj do docker-deploy/.env i uzupełnij przed pierwszym uruchomieniem.
# Generuj APP_KEY: docker compose run --rm app php artisan key:generate --show

APP_NAME="FEER CMS Demo"
APP_KEY=

APP_URL=https://cms-demo.feer.org.pl
HTTP_PORT=3401

# Poczta — domyślnie logi (log), zmień na smtp w produkcji
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@feer.org.pl
MAIL_FROM_NAME="FEER Demo"

# Opcjonalnie (smtp):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
